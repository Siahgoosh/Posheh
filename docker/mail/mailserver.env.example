# Copy to docker/mail/mailserver.env and edit passwords before setup.
# See docs/EMAIL-SETUP.md

DMS_DOMAIN=posheapp.ir
DMS_HOSTNAME=mail.posheapp.ir
ENABLE_SPAMASSASSIN=0
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=1
ONE_DIR=1
SSL_TYPE=self-signed
POSTMASTER_ADDRESS=Info@posheapp.ir
POSTFIX_MESSAGE_SIZE_LIMIT=52428800
