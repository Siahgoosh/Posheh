# Mailu — copy to mailu.env via scripts/setup-mail.sh
# Secrets (password) go in secrets.env (gitignored)

MAILU_VERSION=2024.06
SECRET_KEY=CHANGE_ME_SETUP_SCRIPT
DOMAIN=posheapp.ir
HOSTNAMES=mail.posheapp.ir
POSTMASTER=Info
TLS_FLAVOR=notls
# Must match docker-compose.mail.yml networks.mailu.ipam (setup-mail.sh syncs this)
SUBNET=172.28.203.0/24
ADMIN=true
WEBMAIL=roundcube
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEBROOT_REDIRECT=/webmail
ANTIVIRUS=none
WEBDAV=none
FETCHMAIL_ENABLED=false
MESSAGE_SIZE_LIMIT=52428800
DEFAULT_SPAM_THRESHOLD=80
DISABLE_STATISTICS=True
REAL_IP_HEADER=X-Forwarded-For
REAL_IP_FROM=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
BIND_ADDRESS4=0.0.0.0
BIND_ADDRESS6=::
INITIAL_ADMIN_ACCOUNT=Info
INITIAL_ADMIN_DOMAIN=posheapp.ir
INITIAL_ADMIN_PW=CHANGE_ME
# create (default) crashes on restart when admin already exists — use ifmissing
INITIAL_ADMIN_MODE=ifmissing

# Docker service hostnames (must match docker-compose.mail.yml service names)
ADMIN_ADDRESS=mailu-admin
WEBMAIL_ADDRESS=mailu-webmail
FRONT_ADDRESS=mailu-front
IMAP_ADDRESS=mailu-imap
SMTP_ADDRESS=mailu-smtp
ANTISPAM_ADDRESS=mailu-antispam
REDIS_ADDRESS=mailu-redis
