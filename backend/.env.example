APP_NAME=Posheh
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=posheh
DB_USERNAME=posheh
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use smtp + Mailu after ./scripts/setup-mail.sh (see docs/EMAIL-SETUP.md)
MAIL_MAILER=log
MAIL_HOST=mailu-front
MAIL_PORT=587
MAIL_USERNAME=Info@posheapp.ir
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="Info@posheapp.ir"
MAIL_FROM_NAME="${APP_NAME}"

ZIBAL_MERCHANT=
ZIBAL_SANDBOX=false

# JWT from پنل پیشخوان کافه‌بازار → API (Bearer token for purchase verification)
CAFE_BAZAAR_API_TOKEN=
CAFE_BAZAAR_PACKAGE_NAME=ir.posheapp.posheh
CAFE_BAZAAR_SKU_SOLO=solo01
CAFE_BAZAAR_SKU_OFFICE=office01
CAFE_BAZAAR_SKU_PREMIUM=office02

SMS_PROVIDER=maxsms
SMS_MODE=live
# Abroad server (Netherlands etc.): use Edge API with Access Key — no Iran IP whitelist needed.
# Iran server: set IPPANEL_API_MODE=jspd and use username/password + IP whitelist.
IPPANEL_API_MODE=edge
IPPANEL_API_KEY=
IPPANEL_USERNAME=
IPPANEL_PASSWORD=
IPPANEL_FROM_NUMBER=+983000505
IPPANEL_OTP_FROM_NUMBER=+9810008721297974
IPPANEL_OTP_PATTERN_CODE=qhhly1nai3njev0
IPPANEL_INVITE_PATTERN_CODE=
IPPANEL_BASE_URL=https://edge.ippanel.com/v1

VITE_APP_NAME="${APP_NAME}"
